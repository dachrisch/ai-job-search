NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/job_search
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secret-key-here
ENCRYPTION_KEY=32-char-encryption-key-here

# SearXNG (search.lehel.xyz) — used for hidden-gem company discovery
SEARXNG_URL=https://search.lehel.xyz
SEARXNG_TOKEN=changeme

# opencode (code.lehel.xyz) — AI agent backend for discovery/classification.
# OPENCODE_API_KEY is managed in the servyy-container infra repo (opencode.api_key).
OPENCODE_BASE_URL=http://code.lehel.xyz
OPENCODE_API_KEY=changeme
# Models are discovered from opencode's registry (GET /api/model): active cost-0
# `opencode` models first, then the paid fallback. Optional overrides (provider:id):
# OPENCODE_MODELS=opencode:mimo-v2.6-flash-free,opencode:big-pickle
# OPENCODE_PAID_MODEL=opencode-go:deepseek-v4.1-flash
